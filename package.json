{
  "name": "quantum-leaps",
  "version": "2.0.0",
  "private": true,
  "description": "Static HR services and recruitment website",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "build": "node scripts/build.cjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4321",
    "test": "node tests/google-webhook.cjs && node tests/hr-check.cjs && python3 tests/site-contracts.py",
    "format": "prettier --write src astro.config.mjs scripts/build.cjs package.json",
    "format:check": "prettier --check src astro.config.mjs scripts/build.cjs package.json"
  },
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "devDependencies": {
    "astro": "6.4.8",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1"
  },
  "overrides": {
    "unifont": "0.7.4"
  }
}
