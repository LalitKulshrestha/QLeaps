---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import EngagementPlan from '../components/EngagementPlan.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { services } from '../data/services.js';
export function getStaticPaths() {
  return services
    .filter((service) => service.slug !== 'recruitment')
    .map((service) => ({
      params: { service: service.slug },
      props: { service },
    }));
}
const { service } = Astro.props;
const path = `/${service.slug}/`;
const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: service.name,
    serviceType: service.name,
    description: service.summary,
    url: `https://qleaps.in${path}`,
    provider: { '@id': 'https://qleaps.in/#organization' },
    areaServed: 'IN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://qleaps.in/',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Services',
        item: 'https://qleaps.in/services/',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: service.name,
        item: `https://qleaps.in${path}`,
      },
    ],
  },
];
---

<SiteLayout
  title={`${service.name} in India | Quantum Leaps`}
  description={service.summary}
  path={path}
  schemas={schemas}
>
  <main id="main">
    <section class="wrap page-intro service-intro">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a
          href="/services/">Services</a
        ><span aria-hidden="true">/</span><span>{service.name}</span>
      </nav><div class="service-hero-grid">
        <div>
          <p class="eyebrow">
            {service.number} / {service.name} · {service.audience}
          </p><h1>{service.headline}</h1><p class="section-description">
            {service.summary}
          </p>{
            service.price && (
              <p class="service-price">
                <strong>{service.price}</strong>
                {service.originalPrice && (
                  <span class="previous-price">
                    <span class="sr-only">Previously </span>
                    <s>{service.originalPrice}</s>
                  </span>
                )}{' '}
                {service.priceLabel}
                {service.offerLabel && (
                  <span class="offer-label">{service.offerLabel}</span>
                )}
              </p>
            )
          }<a
            class="button"
            href={`/contact/?service=${service.slug}#service-enquiry`}
            >{
              service.slug === 'career-prep'
                ? 'Ask about Career Prep'
                : 'Talk through your priorities'
            }<Arrow diagonal /></a
          >
        </div><img
          src={service.image}
          alt={service.imageAlt}
          width={service.imageWidth}
          height={service.imageHeight}
          style={`object-position:${service.imagePosition}`}
          class="service-hero-photo"
        />
      </div>
    </section>
    {
      ['people-setup', 'hiring-support'].includes(service.slug) && (
        <div class="wrap diagnostic-entry">
          <>
            <p>Not sure what your team needs?</p>
            <a class="text-link" href="/services/#diagnostic">
              Try the four-question HR self-check <Arrow diagonal />
            </a>
          </>
        </div>
      )
    }
    <EngagementPlan service={service} />
    <section class="wrap service-scope" aria-labelledby="scopeHeading">
      <div class="scope-intro">
        <p class="eyebrow">A clear scope. Practical support.</p><h2
          id="scopeHeading"
        >
          What we can<br />help you with.
        </h2>{service.note && <p>{service.note}</p>}
      </div><div class="scope-groups">
        {
          service.groups.map((group, index) => (
            <article id={group.id} data-reveal>
              <>
                <span class="scope-number">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <>
                    <h3>{group.title}</h3>
                    <ul>
                      {group.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </>
                </div>
              </>
            </article>
          ))
        }
      </div>
    </section>
    <section class="wrap service-boundary">
      <p class="confidential-note">
        {
          service.audience === 'For companies'
            ? 'We deliver HR service support within your infrastructure and agreed access. Please do not send employee records, payroll data, appraisal files or confidential documents through this website.'
            : 'Start with a non-confidential enquiry. You do not need to upload your CV here to ask about the Career Prep package.'
        }
      </p>
    </section>
    <ClosingCTA
      title={'Start with what matters.\nWe’ll shape the next step.'}
      href={`/contact/?service=${service.slug}#service-enquiry`}
      label={`Discuss ${service.name}`}
    />
  </main>
</SiteLayout>
<style>
  .diagnostic-entry {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 20px 24px;
    background: var(--blue-light);
    border: 1px solid #bfdbfe;
    margin-bottom: 36px;
    color: #475569;
    font-size: 14px;
  }
  .diagnostic-entry a {
    color: var(--blue);
    font-size: 13px;
  }
  @media (max-width: 640px) {
    .diagnostic-entry {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }
  .service-intro .eyebrow {
    color: #1d4ed8;
  }
  .service-hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 64px;
    align-items: center;
  }
  .service-hero-grid h1 {
    white-space: pre-line;
    font-size: clamp(40px, 5vw, 70px);
    margin: 24px 0;
  }
  .service-hero-grid .button {
    margin-top: 28px;
  }
  .service-hero-photo {
    width: 100%;
    height: 430px;
    object-fit: cover;
    object-position: center 35%;
    border-radius: 12px;
  }
  .service-price {
    margin-top: 26px;
    font-size: 14px;
    color: var(--muted);
  }
  .previous-price {
    margin-right: 10px;
    color: var(--muted);
    font-size: 18px;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .offer-label {
    display: block;
    font-size: 13px;
    color: var(--muted);
    margin-top: 6px;
  }
  .service-price strong {
    font-family: 'Space Grotesk', sans-serif;
    color: var(--ink);
    font-size: 38px;
    letter-spacing: -0.04em;
    margin-right: 12px;
  }
  .service-scope {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 80px;
    padding: 24px 0 64px;
  }
  .scope-intro {
    position: sticky;
    top: 120px;
    align-self: start;
  }
  .scope-intro .eyebrow {
    color: #1d4ed8;
  }
  .scope-intro h2 {
    font-size: 40px;
    margin: 22px 0;
  }
  .scope-intro > p:last-child {
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
    max-width: 360px;
  }
  .scope-groups article {
    display: flex;
    gap: 24px;
    border-top: 1px solid var(--line);
    padding: 28px 0;
  }
  .scope-number {
    font-size: 10px;
    color: #1d4ed8;
    margin-top: 6px;
  }
  .scope-groups h3 {
    font-size: 24px;
    line-height: 1.25;
    margin-bottom: 18px;
  }
  .scope-groups ul {
    padding-left: 18px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }
  .service-boundary {
    margin-bottom: 48px;
  }
  @media (max-width: 860px) {
    .service-hero-grid {
      gap: 32px;
      grid-template-columns: 1fr 1fr;
    }
    .service-hero-photo {
      height: 360px;
    }
    .service-scope {
      gap: 36px;
      grid-template-columns: 0.8fr 1.2fr;
    }
  }
  @media (max-width: 640px) {
    .service-hero-grid {
      grid-template-columns: 1fr;
    }
    .service-hero-photo {
      height: 280px;
    }
    .service-scope {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .scope-intro {
      position: static;
    }
    .scope-intro h2 {
      font-size: 34px;
    }
    .scope-groups article {
      gap: 16px;
    }
    .service-hero-grid h1 {
      font-size: 42px;
    }
  }
</style>
