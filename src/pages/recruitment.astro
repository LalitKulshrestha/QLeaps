              >
              </div>
            </div>

            <!-- Dynamic Shortlist Cards Unfolded on Filter -->
            <div
              id="qlFitCardsTray"
              style="display:none;flex-direction:column;gap:10px;padding-top:6px;border-top:1px dashed rgba(255,255,255,.2)"
            >
              <div
                style="font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#FF6B4A"
              >
                Example brief: Growth Marketing Manager · Fictional profiles
              </div>
              <div
                style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,160px),1fr));gap:10px"
              >
                <div
                  style="background:rgba(255,255,255,.07);border:1px solid rgba(255,107,74,.4);border-radius:14px;padding:12px;display:flex;flex-direction:column;gap:4px"
                >
                  <span
                    style="font-size:11px;font-weight:700;color:#FF6B4A;letter-spacing:.06em"
                    >PROFILE 01</span
