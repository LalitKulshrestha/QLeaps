  <script>
    function setupTerminalTabs() {
      const tabs = [...document.querySelectorAll('.terminal-tab-btn')];
      const radar = document.getElementById('terminalRadarView');
      const film = document.getElementById('terminalFilmView');
      if (!tabs.length || !radar || !film) return;
      function selectTab(tab, focus = false) {
        tabs.forEach((item) => {
          const selected = item === tab;
          item.classList.toggle('active', selected);
          item.setAttribute('aria-selected', String(selected));
          item.setAttribute('tabindex', selected ? '0' : '-1');
        });
        radar.hidden = tab.dataset.termTarget !== 'radar';
        film.hidden = !radar.hidden;
        if (focus) tab.focus();
        document.dispatchEvent(new Event('ql-motion-change'));
      }
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => selectTab(tab));
        tab.addEventListener('keydown', (event) => {
          let next = null;
          if (event.key === 'ArrowRight') next = (index + 1) % tabs.length;
          if (event.key === 'ArrowLeft')
            next = (index - 1 + tabs.length) % tabs.length;
          if (event.key === 'Home') next = 0;
          if (event.key === 'End') next = tabs.length - 1;
          if (next !== null) {
            event.preventDefault();
            selectTab(tabs[next], true);
          }
        });
      });
    }
    setupTerminalTabs();
  </script>
</SiteLayout>
