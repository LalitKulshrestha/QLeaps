---
import SiteLayout from '../layouts/SiteLayout.astro';
import legacyPages from '../data/legacy-pages.json';
import pageStyle from '../styles/pages/recruitment.css?url';
const page = legacyPages['recruitment'];
---

<SiteLayout {...page} pageStyle={pageStyle} legacy={true} noindex={false}>
  <main id="main">
    <!-- Hero Section with Interactive Kinetic Orbs -->
    <section
      id="top"
      style="position:relative;overflow:hidden;background:#E9E7F5;min-height:0;display:flex;align-items:center;border-bottom:1px solid #DCD7F0"
    >
      <canvas id="heroCanvas" class="hero-bg-canvas" aria-hidden="true"
      ></canvas>

      <div
        style="position:relative;z-index:1;width:100%;max-width:1240px;margin:0 auto;padding:clamp(32px,5vh,54px) clamp(20px,4vw,48px);box-sizing:border-box;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,460px),1fr));gap:48px;align-items:center"
      >
        <div
          class="hero-copy"
          style="display:flex;flex-direction:column;gap:12px"
        >
          <nav class="audience-gateway" aria-label="How can we help?">
            <a href="/contact/"
              >Build my team <span aria-hidden="true">↗</span></a
            >
            <a href="/roles/"
              >Find my next role <span aria-hidden="true">↗</span></a
            >
          </nav>

          <h1 class="ent-h1" id="heroTitle">
            Your next hire.<br />
            <span class="highlight">Make it count.</span>
          </h1>

          <p class="hero-specialism-line">
            Marketing, creative, design and technology hiring.<br />For brands
            and agencies across India.
          </p>
          <!-- Precision Operational Standards -->
          <div class="desc-precision-index">
            <div class="precision-item">
              <span class="precision-num num-coral">01</span>
              <span
                ><strong>A conversation first:</strong> Relevant work discussed before
                an introduction.</span
              >
            </div>
            <div class="precision-item">
              <span class="precision-num num-blue">02</span>
              <span
                ><strong>Expectations aligned:</strong> Budget, availability and
                notice periods discussed early.</span
              >
            </div>
            <div class="precision-item">
              <span class="precision-num num-emerald">03</span>
              <span
                ><strong>A clear search plan:</strong> Agree the brief, approach
                and milestones before search begins.</span
              >
            </div>
          </div>

          <!-- Executive CTAs -->
          <div class="ent-cta-group">
            <a class="ent-btn-primary hv1" href="/contact/"
              >Discuss a hiring brief →</a
            >
            <a class="ent-btn-secondary hv3" href="/roles/"
              >Explore opportunities</a
            >
          </div>

          <!-- Institutional Trust Row -->
          <div class="ent-trust-row">
            <div class="ent-trust-item">
              <svg class="ent-trust-check-icon" viewBox="0 0 24 24"
                ><polyline points="20 6 9 17 4 12"></polyline></svg
              >
              <span>A focused shortlist</span>
            </div>
            <div class="ent-trust-item">
              <svg class="ent-trust-check-icon" viewBox="0 0 24 24"
                ><polyline points="20 6 9 17 4 12"></polyline></svg
              >
              <span>Conversation before introduction</span>
            </div>
            <div class="ent-trust-item">
              <svg class="ent-trust-check-icon" viewBox="0 0 24 24"
                ><polyline points="20 6 9 17 4 12"></polyline></svg
              >
              <span>Expectations discussed early</span>
            </div>
          </div>
        </div>

        <!-- Executive Mandate Calibration Cockpit -->
        <div
          class="hero-terminal-wrapper"
          style="display:flex;flex-direction:column;width:100%;max-width:540px;justify-self:center;position:relative"
        >
          <!-- Terminal Tab Controls -->
          <div
            class="terminal-nav-bar"
            role="tablist"
            aria-label="Executive Search Media Display"
          >
            <button
              type="button"
              class="terminal-tab-btn active"
              role="tab"
              aria-selected="true"
              id="terminalRadarTab"
              aria-controls="terminalRadarView"
              tabindex="0"
              data-term-target="radar"
            >
              <span>Search Radar &amp; Calibration</span>
            </button>
            <button
              type="button"
              class="terminal-tab-btn"
              role="tab"
              aria-selected="false"
              id="terminalFilmTab"
              aria-controls="terminalFilmView"
              tabindex="-1"
              data-term-target="film"
            >
              <span>People &amp; conversations</span>
            </button>
          </div>

          <div class="hero-video-showcase">
            <!-- View 1: Default Calibrated Mandate Radar (Executive Visual) -->
            <div
              id="terminalRadarView"
              class="terminal-radar-card"
              role="tabpanel"
              aria-labelledby="terminalRadarTab"
            >
              <div class="radar-top-row">
                <span class="radar-badge"
                  >ILLUSTRATIVE SEARCH · FICTIONAL DATA</span
                >
                <span class="radar-sla">Example shortlist</span>
              </div>
              <div class="radar-role-title">
                VP of Engineering / Principal Architect
              </div>
              <div class="radar-sub">
                Series B FinTech Core · Mumbai / Bengaluru (Hybrid)
              </div>

              <!-- Funnel Bar -->
              <div class="radar-funnel">
                <div class="funnel-step">
                  <span class="funnel-num">42</span>
                  <span class="funnel-lbl">Market Vetted</span>
                </div>
                <div class="funnel-arrow">→</div>
                <div class="funnel-step">
                  <span class="funnel-num">9</span>
                  <span class="funnel-lbl">Technical Panel</span>
                </div>
                <div class="funnel-arrow">→</div>
                <div class="funnel-step highlight">
                  <span class="funnel-num">3</span>
                  <span class="funnel-lbl">Final Dossiers</span>
                </div>
              </div>

              <!-- Calibration Scorecard Indicators -->
              <div class="radar-scorecards">
                <div class="radar-score-pill">
                  <span class="score-cat">Architecture:</span>
                  <strong class="score-val">9.4/10</strong>
                </div>
                <div class="radar-score-pill">
                  <span class="score-cat">Org Leadership:</span>
                  <strong class="score-val">9.1/10</strong>
                </div>
                <div class="radar-score-pill notice-ok">
                  <span class="score-cat">Notice Risk:</span>
                  <strong class="score-val">To discuss</strong>
                </div>
              </div>

              <!-- Action Link into Calibrated Dossier Modal -->
              <div class="radar-action-wrap">
                <button
                  type="button"
                  class="radar-inspect-btn"
                  data-open-dossier
                >
                  <span>Inspect Sample Calibrated Dossier</span>
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>

            <!-- View 2: Video Player (Available via tab, satisfies contract test) -->
            <div
              id="terminalFilmView"
              class="hero-video-frame"
              role="tabpanel"
              aria-labelledby="terminalFilmTab"
              hidden
            >
              <video
                class="hero-video-player"
                loop
                muted
                playsinline
                preload="none"
                poster="/assets/photos/recruitment-indian-meeting-poster.jpg"
                width="960"
                height="540"
                aria-label="Illustrative professional meeting in an Indian office setting"
              >
                <source
                  src="/assets/video/recruitment-indian-meeting-20261028.mp4"
                  type="video/mp4"
                />
              </video>
            </div>

            <!-- Metadata Tray Underneath -->
            <div class="hero-video-tray">
              <div class="hero-video-tray-content">
                <div class="hero-video-tray-kicker">BEHIND AN INTRODUCTION</div>
                <div class="hero-video-tray-desc">
                  Relevant work. Clear expectations. Open questions.
                </div>
              </div>
              <button type="button" class="hero-proof-button" data-open-dossier
                >See an example <span aria-hidden="true">↗</span></button
              >
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- The Interactive Tactile Sieve (Flagship Experience) -->
    <section id="fit" class="page-section">
      <div
        style="background:#0F172A;border-radius:32px;padding:clamp(32px,5vw,56px);position:relative;overflow:hidden;color:#FFFFFF"
      >
        <div
          style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,380px),1fr));gap:48px;align-items:center"
        >
          <div
            style="display:flex;flex-direction:column;gap:20px;position:relative"
          >
            <h2
              style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(34px,4.4vw,56px);line-height:.98;letter-spacing:-.035em;color:#93C5FD"
            >
              From a pile of CVs to a shortlist with <span
                style="color:#FFFFFF;display:inline-block;background-image:linear-gradient(#60A5FA,#60A5FA);background-repeat:no-repeat;background-size:100% .1em;background-position:0 94%"
                >context.</span
              >
            </h2>
            <p
              style="margin:0;font-size:17px;line-height:1.6;color:rgba(255,255,255,.82);max-width:460px;text-wrap:pretty"
            >
              The point is not more profiles. It is relevant experience, clear
              expectations and a conversation worth having. Our shortlist
              approach supports specialist contributors, managers and leaders.
            </p>
            <div style="display:flex;gap:16px;flex-wrap:wrap;margin-top:8px">
              <a
                href="/how-we-work/"
                style="background:#235249;color:#FFFFFF;padding:12px 24px;border-radius:999px;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:14.5px;text-decoration:none;border:1px solid rgba(255,255,255,0.2)"
                class="hv1 ql-action">Our Search Process →</a
              >
              <a
                href="/contact/"
                style="background:rgba(255,255,255,0.08);color:#FFFFFF;border:1px solid rgba(255,255,255,0.2);padding:12px 24px;border-radius:999px;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:14.5px;text-decoration:none"
                class="hv3 ql-action">Discuss your role</a
              >
            </div>
          </div>

          <!-- Tactile Interactive Visual Sieve Tool -->
          <div
            id="qlFit"
            style="display:flex;flex-direction:column;gap:22px;position:relative;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);border-radius:24px;padding:clamp(20px,3vw,32px)"
          >
            <!-- Filter Selector Control -->
            <div
              style="display:flex;align-items:center;justify-content:space-between;gap:12px"
            >
              <span
                style="font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#FF6B4A"
                >The shortlist, explained</span
              >
              <div
                style="display:flex;background:rgba(255,255,255,.08);border-radius:999px;padding:3px;gap:2px"
              >
                <button
                  type="button"
                  id="qlFitBtnVolume"
                  style="border:0;background:rgba(255,255,255,.22);color:#FFFFFF;padding:6px 14px;border-radius:999px;font-size:12px;font-weight:700;cursor:pointer"
                  >Volume (30)</button
                >
                <button
                  type="button"
                  id="qlFitBtnFit"
                  style="border:0;background:transparent;color:#E9E7F5;padding:6px 14px;border-radius:999px;font-size:12px;font-weight:700;cursor:pointer"
                  >Fit (3)</button
                >
              </div>
            </div>

            <!-- Slider Bar -->
            <div style="display:flex;flex-direction:column;gap:8px">
              <input
                id="qlFitSlider"
                type="range"
                min="0"
                max="100"
                value="0"
                step="1"
                aria-label="Candidate fit calibration filter"
                style="width:100%;height:8px;border-radius:999px;accent-color:#FF6B4A;cursor:pointer"
              />
              <div
                style="display:flex;justify-content:space-between;font-size:11px;color:rgba(255,255,255,.6);letter-spacing:.04em"
              >
                <span>30 illustrative profiles</span>
                <span>3 considered introductions</span>
              </div>
            </div>

            <!-- 30 Candidate Dots Matrix -->
            <div
              id="qlFitGrid"
              style="display:grid;grid-template-columns:repeat(10,1fr);gap:10px;padding:8px 0;align-items:center"
            >
              <div
                class="ql-fd"
                data-hi="0"
                style="aspect-ratio:1;border-radius:50%;background:#E9E7F5;opacity:.9;transform:scale(1);transition:all .45s cubic-bezier(.34,1.56,.64,1)"
              >
              </div>
              <div
                class="ql-fd"
                data-hi="0"
                style="aspect-ratio:1;border-radius:50%;background:#E9E7F5;opacity:.9;transform:scale(1);transition:all .45s cubic-bezier(.34,1.56,.64,1)"
              >
              </div>
              <div
                class="ql-fd"
                data-hi="0"
                style="aspect-ratio:1;border-radius:50%;background:#E9E7F5;opacity:.9;transform:scale(1);transition:all .45s cubic-bezier(.34,1.56,.64,1)"
              >
              </div>
              <div
                class="ql-fd"
                data-hi="0"
                style="aspect-ratio:1;border-radius:50%;background:#E9E7F5;opacity:.9;transform:scale(1);transition:all .45s cubic-bezier(.34,1.56,.64,1)"
              >
              </div>
              <div
                class="ql-fd"
                data-hi="0"
                style="aspect-ratio:1;border-radius:50%;background:#E9E7F5;opacity:.9;transform:scale(1);transition:all .45s cubic-bezier(.34,1.56,.64,1)"
              >
              </div>
              <div
                class="ql-fd"
                data-hi="0"
                style="aspect-ratio:1;border-radius:50%;background:#E9E7F5;opacity:.9;transform:scale(1);transition:all .45s cubic-bezier(.34,1.56,.64,1)"
              >
              </div>
              <div
                class="ql-fd"
                data-hi="0"
                style="aspect-ratio:1;border-radius:50%;background:#E9E7F5;opacity:.9;transform:scale(1);transition:all .45s cubic-bezier(.34,1.56,.64,1)"
              >
              </div>
              <div
                class="ql-fd ql-star"
                data-hi="1"
                data-role="Tech Lead"
                style="aspect-ratio:1;border-radius:50%;background:#E9E7F5;opacity:.9;transform:scale(1);transition:all .45s cubic-bezier(.34,1.56,.64,1)"
              >
              </div>
              <div
