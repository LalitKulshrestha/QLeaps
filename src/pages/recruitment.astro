            <!-- Caption -->
            <div
              style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap"
            >
              <span
                style="font-family:'Bricolage Grotesque',sans-serif;font-weight:800;font-size:22px;letter-spacing:-.02em"
                id="qlFitCap">30 who might.</span
              >
              <span
                style="font-size:13.5px;color:#E9E7F5;opacity:.85"
                id="qlFitHint">Drag the slider or tap to filter</span
              >
