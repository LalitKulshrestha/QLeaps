---
import SiteLayout from '../layouts/SiteLayout.astro';
import legacyPages from '../data/legacy-pages.json';
import pageStyle from '../styles/pages/blogs.css?url';
const page = legacyPages['blogs'];
---

<SiteLayout {...page} pageStyle={pageStyle} legacy={true} noindex={false}>
  <main id="main">
    <noscript
      ><style is:global>
        #msgForm,
        #jobForm,
        #cvForm,
        #feedbackForm {
          display: none !important;
        }
      </style><p class="no-script-note">
        To send a brief or CV, enable JavaScript or email <a
          href="mailto:contact@qleaps.in">contact@qleaps.in</a
        >.
      </p></noscript
    >
    <!-- Hub Header Dispatch -->
    <section class="blogs-hub-header">
      <h1
        style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(36px,4.5vw,56px);line-height:1.02;letter-spacing:-.04em;color:#0F172A"
      >
        Hiring decisions.<br />Career possibilities.
      </h1>

      <p
        style="margin:0;font-size:clamp(16px,1.8vw,19px);line-height:1.6;color:#475569;max-width:820px"
      >
        Practical guides for hiring teams and candidates: clearer briefs, better
        conversations and considered career decisions.
      </p>

      <!-- Search + Filter Controls -->
      <div
        style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between;margin-top:12px"
      >
        <div class="blogs-filter-row" style="margin:0">
          <button type="button" class="blog-filter-btn active" data-filter="all"
            >All Memos (6)</button
          >
          <button
            type="button"
            class="blog-filter-btn"
            data-filter="notice-periods">Notice Periods</button
          >
          <button
            type="button"
            class="blog-filter-btn"
            data-filter="search-economics">Search Economics</button
          >
          <button
            type="button"
            class="blog-filter-btn"
            data-filter="compensation">Compensation</button
          >
          <button
            type="button"
            class="blog-filter-btn"
            data-filter="candidate-guides">Candidate Guides</button
          >
        </div>

        <div class="blog-search-bar">
          <svg viewBox="0 0 24 24"
            ><circle cx="11" cy="11" r="8"></circle><line
              x1="21"
              y1="21"
              x2="16.65"
              y2="16.65"></line></svg
          >
          <input
            id="blogSearch"
            type="search"
            placeholder="Search hiring and career guides…"
            aria-label="Search articles"
          />
        </div>
      </div>
    </section>

    <!-- Memos & Guides Grid -->
    <p id="blogResultsStatus" class="filter-status" role="status"></p>
    <section class="blogs-hub-grid">
      <!-- Card 1: 90-Day Notice Period -->
      <article
        class="blog-card"
        data-category="notice-periods"
        id="memo-notice-period"
      >
        <div class="blog-card-meta">
          <span class="blog-tag">Executive Retention</span>
          <span class="blog-read-time">25 October 2026 · 2 min read</span>
        </div>
        <h2 class="blog-card-title">
          Managing a Notice Period: A Clearer Path from Offer to Joining
        </h2>
        <p class="blog-card-excerpt">
          Practical steps for staying aligned through a long notice period,
          without promising that every dropout can be prevented.
        </p>
        <a class="blog-read-btn hv3" href="/blogs/notice-period/"
          >Read article →</a
        >
      </article>

      <!-- Card 2: Search Economics -->
      <article
        class="blog-card"
        data-category="search-economics"
        id="memo-search-economics"
      >
        <div class="blog-card-meta">
          <span class="blog-tag">Search Economics</span>
          <span class="blog-read-time">25 October 2026 · 2 min read</span>
        </div>
        <h2 class="blog-card-title">
          Why a Focused Shortlist Beats a Pile of CVs
        </h2>
        <p class="blog-card-excerpt">
          A useful shortlist explains relevant evidence, tradeoffs and open
          questions instead of asking the hiring manager to start screening
          again.
        </p>
        <a class="blog-read-btn hv3" href="/blogs/search-economics/"
          >Read article →</a
        >
      </article>

      <!-- Card 3: Compensation Benchmarking 2026 -->
      <article
        class="blog-card"
        data-category="compensation"
        id="memo-compensation-benchmarks"
      >
        <div class="blog-card-meta">
          <span class="blog-tag">Compensation Guide</span>
          <span class="blog-read-time">25 October 2026 · 2 min read</span>
        </div>
        <h2 class="blog-card-title">
          Compensation Conversations: Look Beyond Headline CTC
        </h2>
        <p class="blog-card-excerpt">
          A practical checklist for comparing fixed pay, variable pay and
          equity. This is guidance, not a salary survey or market benchmark.
        </p>
        <a class="blog-read-btn hv3" href="/blogs/compensation-benchmarks/"
          >Read article →</a
        >
      </article>

      <!-- Card 4: Candidate Guide - Offer Due Diligence -->
      <article
        class="blog-card"
        data-category="candidate-guides"
        id="memo-offer-questions"
      >
        <div class="blog-card-meta">
          <span class="blog-tag">Candidate Guide</span>
          <span class="blog-read-time">25 October 2026 · 2 min read</span>
        </div>
        <h2 class="blog-card-title">Four Questions Before Accepting a Role</h2>
        <p class="blog-card-excerpt">
          Clarify ownership, expectations and support before making your next
          move.
        </p>
        <a class="blog-read-btn hv3" href="/blogs/offer-questions/"
          >Read article →</a
        >
      </article>

      <!-- Card 5: Candidate Guide - Portfolio Thinking -->
      <article
        class="blog-card"
        data-category="candidate-guides"
        id="memo-portfolio-thinking"
      >
        <div class="blog-card-meta">
          <span class="blog-tag">Candidate Guide</span>
          <span class="blog-read-time">25 October 2026 · 2 min read</span>
        </div>
        <h2 class="blog-card-title">
          Show How You Think: A Better Portfolio Conversation
        </h2>
        <p class="blog-card-excerpt">
          Make your contribution, constraints and decisions easy for a hiring
          team to understand.
        </p>
        <a class="blog-read-btn hv3" href="/blogs/portfolio-thinking/"
          >Read article →</a
        >
      </article>

      <!-- Card 6: Candidate Guide - Serving Notice with Impact -->
      <article
        class="blog-card"
        data-category="candidate-guides"
        id="memo-serving-notice"
      >
        <div class="blog-card-meta">
          <span class="blog-tag">Candidate Guide</span>
          <span class="blog-read-time">25 October 2026 · 2 min read</span>
        </div>
        <h2 class="blog-card-title">
          Serving Notice: Finish Well and Prepare for What’s Next
        </h2>
        <p class="blog-card-excerpt">
          A practical handover and joining checklist that respects both your
          current and future teams.
        </p>
        <a class="blog-read-btn hv3" href="/blogs/serving-notice/"
          >Read article →</a
        >
      </article>
    </section>

    <!-- Dedicated Writing & Reader Perspectives Desk -->
    <section
      style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px) clamp(60px,8vw,100px)"
    >
      <div
        class="blog-feedback-box"
        style="background:linear-gradient(135deg, #F8FAFC 0%, #FFFFFF 100%);border:1px solid #E2E8F0;border-radius:28px;padding:clamp(28px,4vw,44px);box-shadow:0 10px 30px rgba(0,0,0,0.03);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,360px),1fr));gap:clamp(24px,4vw,48px);align-items:start"
      >
        <div style="display:flex;flex-direction:column;gap:14px">
          <div
            style="display:inline-flex;align-items:center;gap:8px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#047857;background:#ECFDF5;border:1px solid #A7F3D0;padding:5px 12px;border-radius:999px;width:fit-content"
          >
            <svg
              style="width:13px;height:13px;stroke:#059669;fill:none"
              viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Direct Partner Advisory · Reader Perspectives
          </div>
          <h2
            style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(24px,2.8vw,34px);letter-spacing:-.03em;color:#0F172A;line-height:1.15"
          >
            Have a perspective or want to request research?
          </h2>
          <p style="margin:0;font-size:15px;line-height:1.6;color:#475569">
            Share a hiring challenge, suggest a guide or tell us what would make
            these resources more useful.
          </p>
          <p style="margin:0;font-size:14px;line-height:1.55;color:#64748B">
            Every submission is read directly by our leadership team. We review
            requests and respond where we can contribute useful guidance.
          </p>
        </div>

        <form
          id="feedbackForm"
          method="POST"
          action="#feedbackForm"
          class="blog-feedback-form"
          style="display:flex;flex-direction:column;gap:14px"
        >
          <input type="hidden" name="form_type" value="Editorial Feedback" /><p
            hidden
          >
            <label
              >Leave empty <input
                name="bot-field"
                tabindex="-1"
                autocomplete="off"
              /></label
            >
          </p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div>
              <label
                for="fbName"
                style="display:block;font-size:13px;font-weight:600;color:#334155;margin-bottom:4px"
                >Your name *</label
              >
              <input
                id="fbName"
                name="name"
                type="text"
                required
                placeholder="Full name"
              />
            </div>
            <div>
              <label
                for="fbEmail"
                style="display:block;font-size:13px;font-weight:600;color:#334155;margin-bottom:4px"
                >Work email *</label
              >
              <input
                id="fbEmail"
                name="email"
                type="email"
                autocapitalize="none"
                spellcheck="false"
                required
                placeholder="you@company.com"
              />
            </div>
          </div>

          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
            <div>
              <label
                for="fbRole"
                style="display:block;font-size:13px;font-weight:600;color:#334155;margin-bottom:4px"
                >Your role &amp; organisation</label
              >
              <input
                id="fbRole"
                name="role"
                type="text"
                placeholder="e.g. VP Engineering, Acme Labs"
              />
            </div>
            <div>
              <label
                for="fbTopic"
                style="display:block;font-size:13px;font-weight:600;color:#334155;margin-bottom:4px"
                >Research topic or essay</label
              >
              <select id="fbTopic" name="topic">
                <option value="General Editorial Feedback"
                  >General Editorial Feedback</option
                >
                <option value="90-Day Notice Period Strategies"
                  >90-Day Notice Period Strategies</option
                >
                <option value="Executive Compensation Benchmarks"
                  >Executive Compensation Benchmarks</option
                >
                <option value="Search Economics & Shortlisting"
                  >Search Economics &amp; Shortlisting</option
                >
                <option value="Candidate Guides & Offers"
                  >Candidate Guides &amp; Offers</option
                >
                <option value="Suggest New Mandate Research"
                  >Suggest New Mandate Research</option
                >
              </select>
            </div>
          </div>

          <div>
            <label
              for="fbPerspective"
              style="display:block;font-size:13px;font-weight:600;color:#334155;margin-bottom:4px"
              >Your perspective, challenge or question *</label
            >
            <textarea
              id="fbPerspective"
              name="message"
              required
              rows="3"
              placeholder="Share your experience, hiring challenges, or thoughts on this research..."
            ></textarea>
          </div>

          <label
            class="consent"
            style="display:flex;align-items:flex-start;gap:10px;font-size:13px;color:#475569;cursor:pointer"
          >
            <input
              type="checkbox"
              name="consent"
              required
              style="width:auto;margin-top:3px;flex:none"
            />
            <span
              >I agree to be contacted regarding this perspective. <a
                href="/privacy.html"
                style="color:#2563eb;text-decoration:underline"
                >Privacy policy</a
              ></span
            >
          </label>

          <button
            type="submit"
            style="align-self:flex-start;background:#2563eb;color:#FFFFFF;border:0;border-radius:999px;padding:12px 24px;font-family:'Space Grotesk',sans-serif;font-size:14.5px;font-weight:700;cursor:pointer;box-shadow:0 4px 14px rgba(37,99,235,0.25);transition:all .2s ease"
            >Submit perspective →</button
          >
          <p
            id="feedbackStatus"
            role="status"
            style="margin:0;font-size:13.5px;color:#2563eb;font-weight:500"
          >
          </p>
        </form>
      </div>
    </section>
  </main>
</SiteLayout>
