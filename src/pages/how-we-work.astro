---
import SiteLayout from '../layouts/SiteLayout.astro';
import legacyPages from '../data/legacy-pages.json';
import pageStyle from '../styles/pages/how-we-work.css?url';
const page = legacyPages['how-we-work'];
---

<SiteLayout {...page} pageStyle={pageStyle} legacy={true} noindex={false}>
  <main id="main">
    <!-- How We Work Hero Header -->
    <section class="hww-hero">
      <div style="display:flex;flex-direction:column;gap:12px;max-width:820px">
        <span
          style="font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#2563eb"
          >Search Methodology &amp; Standards</span
        >
        <h1
          style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(34px,4.5vw,54px);line-height:1.02;letter-spacing:-.035em;color:#0f172a"
        >
          A clear brief.<br />A considered introduction.
        </h1>
        <p style="margin:0;font-size:17px;line-height:1.6;color:#475569">
          A long list of CVs is not a hiring decision. We agree the work,
          explore relevant experience and introduce people with context.
          Shortlist size and timing are agreed for each search.
        </p>
      </div>
    </section>

    <!-- 4-Step Process Timeline -->
    <section
      style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px) 60px"
    >
      <div
        style="position:relative;background:#F8FAFC;border:1px solid #E2E8F0;border-radius:28px;padding:clamp(28px,4vw,48px)"
      >
        <div
          style="display:flex;flex-direction:column;gap:10px;margin-bottom:40px"
        >
          <span
            style="font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#64748B"
            >A clear search cadence</span
          >
          <h2
            style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(24px,3vw,34px);letter-spacing:-.03em;color:#0F172A"
          >
            From brief intake to evaluated shortlist.
          </h2>
        </div>

        <div
          style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:28px;position:relative"
        >
          <!-- Step 1 -->
          <div
            class="ql-step"
            style="display:flex;flex-direction:column;gap:14px"
          >
            <div
              style="width:52px;height:52px;border-radius:50%;background:#FF5733;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;box-shadow:0 0 0 6px #FFFFFF"
            >
              01
            </div>
            <span
              style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#B93D28"
              >01 · Alignment</span
            >
            <h3
              style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:22px;color:#0F172A"
            >
              Agree the brief
            </h3>
            <p style="margin:0;font-size:15px;line-height:1.55;color:#475569">
              We discuss the role, reporting lines, priorities and budget with
              the hiring team, then agree what a strong candidate needs to
              bring.
            </p>
          </div>

          <!-- Step 2 -->
          <div
            class="ql-step"
            style="display:flex;flex-direction:column;gap:14px"
          >
            <div
              style="width:52px;height:52px;border-radius:50%;background:#2563eb;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;box-shadow:0 0 0 6px #FFFFFF"
            >
              02
            </div>
            <span
              style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#2563eb"
              >02 · Research & outreach</span
            >
            <h3
              style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:22px;color:#0f172a"
            >
              Research & outreach
            </h3>
            <p style="margin:0;font-size:15px;line-height:1.55;color:#475569">
              We research relevant teams, portfolios and career paths, then
              start direct conversations about the role.
            </p>
          </div>

          <!-- Step 3 -->
          <div
            class="ql-step"
            style="display:flex;flex-direction:column;gap:14px"
          >
            <div
              style="width:52px;height:52px;border-radius:50%;background:#7C3AED;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;box-shadow:0 0 0 6px #FFFFFF"
            >
              03
            </div>
            <span
              style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#7C3AED"
              >03 · Introduction</span
            >
            <h3
              style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:22px;color:#0F172A"
            >
              Considered introductions
            </h3>
            <p style="margin:0;font-size:15px;line-height:1.55;color:#475569">
              You receive a focused shortlist with relevant experience, open
              questions and expectations discussed with the candidate. We agree
              scope and timing around the brief.
            </p>
            <button
              type="button"
              class="open-dossier-btn shortlist-example-button process-example-button"
              >Inspect sample dossier <span aria-hidden="true">→</span></button
            >
            <span class="sample-disclaimer"
              >Illustrative profiles · fictional data</span
            >
          </div>

          <!-- Step 4 -->
          <div
            class="ql-step"
            style="display:flex;flex-direction:column;gap:14px"
          >
            <div
              style="width:52px;height:52px;border-radius:50%;background:#059669;color:#FFFFFF;display:flex;align-items:center;justify-content:center;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:18px;box-shadow:0 0 0 6px #FFFFFF"
            >
              04
            </div>
            <span
              style="font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:#047857"
              >04 · Offer & joining</span
            >
            <h3
              style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:22px;color:#0F172A"
            >
              Offer & joining support
            </h3>
            <p style="margin:0;font-size:15px;line-height:1.55;color:#475569">
              We keep in touch through notice periods, discuss changes early and
              help both sides prepare for joining. No process can remove every
              risk.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Core Strategic Standards -->
    <section
      style="max-width:1240px;margin:0 auto;padding:0 clamp(20px,4vw,48px) 60px"
    >
      <div
        style="display:flex;flex-direction:column;gap:12px;margin-bottom:32px"
      >
        <span
          style="font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#2563eb"
          >The Quantum Leaps Difference</span
        >
        <h2
          style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(28px,3.4vw,40px);letter-spacing:-.03em;color:#0f172a"
        >
          Three checks that make hiring decisions clearer.
        </h2>
      </div>

      <div
        style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:28px"
      >
        <div class="method-pillar">
          <span
            style="font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#B93D28"
            >Standard 01</span
          >
          <h3
            style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:20px;color:#0F172A"
          >
            Strict Pre-Screening
          </h3>
          <p style="margin:0;font-size:15px;line-height:1.6;color:#475569">
            We discuss relevant work, responsibilities and motivation with
            candidates before making an introduction. We highlight what is
            understood and what still needs checking.
          </p>
        </div>

        <div class="method-pillar">
          <span
            style="font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#2563eb"
            >Standard 02</span
          >
          <h3
            style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:20px;color:#0f172a"
          >
            Compensation &amp; expectations
          </h3>
          <p style="margin:0;font-size:15px;line-height:1.6;color:#475569">
            We break down current CTC into fixed base, performance bonus, and
            unvested equity before scheduling first client interviews.
            Candidates are pre-aligned on the role's budget band.
          </p>
        </div>

        <div class="method-pillar">
          <span
            style="font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#047857"
            >Standard 03</span
          >
          <h3
            style="margin:0;font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:20px;color:#0F172A"
          >
            Notice Period Governance
          </h3>
          <p style="margin:0;font-size:15px;line-height:1.6;color:#475569">
            Long notice periods can introduce uncertainty. We discuss
            availability, maintain agreed touchpoints and flag changes in
            expectations before joining.
          </p>
        </div>
      </div>
    </section>

    <section
      class="process-close page-section"
      aria-labelledby="processCloseHeading"
    >
      <div>
        <p class="overline">A thoughtful introduction</p><h2
          id="processCloseHeading"
        >
          The context matters<br />as much as the CV.
        </h2><p>
          Discuss the brief, see an example of the shortlist context, and decide
          the next step with our team.
        </p>
      </div>
      <div class="process-close-actions">
        <button class="hero-proof-button" type="button" data-open-dossier
          >See a shortlist example ↗</button
        ><a class="brand-button" href="/contact/">Discuss a role →</a>
      </div>
    </section>
  </main>
</SiteLayout>
