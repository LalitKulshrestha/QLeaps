---
import Arrow from './Arrow.astro';
---

<section class="confidentiality" aria-labelledby="confidentialityHeading">
  <div class="wrap privacy-grid" data-reveal>
    <div class="privacy-mark" aria-hidden="true">
      <div class="privacy-orbit orbit-one"></div><div
        class="privacy-orbit orbit-two"
      >
      </div><span>Yours.</span><small>Systems · Access · Control</small>
    </div>
    <div class="privacy-copy">
      <p class="eyebrow">Support without the data handover</p><h2
        id="confidentialityHeading"
      >
        Your systems.<br />Your control.
      </h2><p>
        Our HR service work happens within your infrastructure and agreed
        access. Your people information stays in the systems you manage.
      </p><p class="privacy-instruction">
        Please don’t send employee records, payroll files, appraisal histories
        or confidential documents through this website. Start with your
        priorities, not your data.
      </p><a class="text-link" href="/contact/#service-enquiry"
        >Talk through what you need <Arrow /></a
      ><small
        >Recruitment has its own clearly labelled CV and JD submission process.</small
      >
    </div>
  </div>
</section>
<style>
  .confidentiality {
    padding: 76px 0;
    background: #eff6ff;
    border-block: 1px solid #dbeafe;
    overflow: hidden;
  }
  .privacy-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 96px;
    align-items: center;
  }
  .privacy-mark {
    position: relative;
    min-height: 340px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .privacy-mark > span {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 68px;
    letter-spacing: -0.05em;
    position: relative;
  }
  .privacy-mark > small {
    font-size: 10px;
    letter-spacing: 0.08em;
    position: relative;
    margin-top: 8px;
    color: #475569;
  }
  .privacy-orbit {
    position: absolute;
    border: 1px solid #2563eb4d;
    width: 310px;
    height: 310px;
    border-radius: 50%;
    animation: privacy-orbit 20s linear infinite;
  }
  .orbit-two {
    width: 260px;
    height: 260px;
    border-style: dashed;
    animation-direction: reverse;
    animation-duration: 30s;
  }
  .privacy-orbit::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -4px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #2563eb;
  }
  .privacy-copy > .eyebrow {
    color: #1d4ed8;
  }
  .privacy-copy h2 {
    font-size: clamp(38px, 4.5vw, 60px);
    margin: 20px 0 26px;
  }
  .privacy-copy p:not(.eyebrow) {
    color: #334155;
    font-size: 17px;
    line-height: 1.7;
  }
  .privacy-copy .privacy-instruction {
    font-size: 14px !important;
    border-left: 2px solid #93c5fd;
    padding-left: 18px;
    margin-top: 22px;
  }
  .privacy-copy > a {
    margin-top: 24px;
  }
  .privacy-copy > small {
    display: block;
    margin-top: 18px;
    color: #475569;
    font-size: 11px;
    line-height: 1.6;
  }
  @keyframes privacy-orbit {
    to {
      transform: rotate(360deg);
    }
  }
  @media (max-width: 860px) {
    .privacy-grid {
      gap: 32px;
      grid-template-columns: 1fr 1.3fr;
    }
    .privacy-mark {
      min-height: 260px;
    }
    .privacy-orbit {
      width: 240px;
      height: 240px;
    }
    .orbit-two {
      width: 200px;
      height: 200px;
    }
  }
  @media (max-width: 640px) {
    .confidentiality {
      padding: 44px 0;
    }
    .privacy-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .privacy-mark {
      min-height: 230px;
    }
    .privacy-mark > span {
      font-size: 54px;
    }
    .privacy-orbit {
      width: 210px;
      height: 210px;
    }
    .orbit-two {
      width: 170px;
      height: 170px;
    }
    .privacy-copy p:not(.eyebrow) {
      font-size: 16px;
    }
  }
</style>
