---
import { services } from '../data/services.js';
import Arrow from './Arrow.astro';
const { showIntro = true } = Astro.props;
---

<section
  id="services"
  class:list={[
    'wrap services-section',
    { 'section-space': showIntro, 'services-compact': !showIntro },
  ]}
  aria-labelledby="servicesHeading"
  data-service-explorer
>
  {
    showIntro ? (
      <div class="services-heading" data-reveal>
        <p class="eyebrow">The Quantum Leaps ecosystem</p>
        <h2 class="section-heading" id="servicesHeading">
          A new hire. A stronger team.
          <br />A clearer way forward.
        </h2>
        <p class="section-description">
          Four services for companies. One for your career.
          <br />
          Start where you are. Build what you need.
        </p>
      </div>
    ) : (
      <h2 id="servicesHeading" class="compact-heading">
        Choose your starting point
      </h2>
    )
  }
  <div class="explorer-grid" data-reveal>
    <div
      class="service-menu"
      role="group"
      aria-label="Explore our five service lines"
    >
      {
        services.map((service, index) => (
          <button
            type="button"
            data-service-choice={service.slug}
            aria-controls={`service-${service.slug}`}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            <span class="service-number">{service.number}</span>
            <span class="service-label">
              <>
                <strong>{service.name}</strong>
                <small>
                  {service.audience}
                  {service.price
                    ? ` · ${service.price} ${service.priceLabel}`
                    : ''}
                </small>
              </>
            </span>
            <Arrow diagonal />
          </button>
        ))
      }
    </div>
    <div class="service-panels">
      {
        services.map((service, index) => (
          <article
            class="service-panel"
            id={`service-${service.slug}`}
            data-service-panel={service.slug}
            hidden={index !== 0}
          >
            <div class="service-photo">
              <>
                <img
                  src={service.image}
                  alt={service.imageAlt}
                  width={service.imageWidth}
                  height={service.imageHeight}
                  style={`object-position:${service.imagePosition}`}
                  loading="lazy"
                />
                <span>{service.label}</span>
              </>
            </div>
            <div class="service-panel-copy">
              <>
                <h3>{service.headline}</h3>
                <p>{service.summary}</p>
              </>
              <ul>
                {service.focus.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <details class="service-deliverables">
                <summary>Explore the full scope</summary>
                {service.groups.map((group) => (
                  <div>
                    <h4>{group.title}</h4>
                    <ul>
                      {group.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                ))}
              </details>
              {service.offerLabel && (
                <p class="service-offer">
                  {service.price} {service.priceLabel} · Previously{' '}
                  <s>{service.originalPrice}</s> · {service.offerLabel}
                </p>
              )}
              <a class="text-link" href={`/${service.slug}/`}>
                Explore {service.name}
                <Arrow />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
  <noscript
    ><p>
      Explore our services: {
        services.map((service) => (
          <a href={`/${service.slug}/`}>{service.name} · </a>
        ))
      }
    </p></noscript
  >
</section>
<style>
  .services-compact {
    padding-bottom: 64px;
  }
  .compact-heading {
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0;
    color: #475569;
    margin-bottom: 20px;
  }
  .services-heading {
    margin-bottom: 48px;
  }
  .services-heading .eyebrow {
    color: var(--blue);
  }
  .services-heading h2 {
    margin: 24px 0;
  }
  .explorer-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 64px;
    align-items: start;
  }
  .service-menu {
    display: flex;
    flex-direction: column;
  }
  .service-menu button {
    display: flex;
    align-items: center;
    gap: 20px;
    text-align: left;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    padding: 24px 16px;
    min-width: 0;
    transition: background 0.2s;
  }
  .service-menu button[aria-pressed='true'] {
    background: var(--blue-light);
    color: var(--blue);
  }
  .service-menu button:hover {
    background: var(--surface-cream);
  }
  .service-number {
    font-size: 11px;
    align-self: flex-start;
    padding-top: 6px;
  }
  .service-label {
    flex: 1;
    min-width: 0;
  }
  .service-label strong {
    display: block;
    font-family: 'Space Grotesk', sans-serif;
    font-size: 24px;
    line-height: 1.3;
  }
  .service-label small {
    display: block;
    font-size: 11px;
    margin-top: 10px;
    color: var(--muted);
    line-height: 1.6;
  }
  .service-photo {
    position: relative;
  }
  .service-photo img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    object-position: center 35%;
    display: block;
    border-radius: 8px 8px 0 0;
  }
  .service-photo > span {
    position: absolute;
    bottom: 16px;
    left: 20px;
    background: #ffffffed;
    color: var(--ink);
    padding: 6px 10px;
    font-size: 10px;
    border-radius: 3px;
  }
  .service-panel {
    border: 1px solid var(--line);
    border-radius: 8px;
    overflow: hidden;
    background: var(--paper);
  }
  .service-panel-copy {
    padding: 30px;
  }
  .service-panel h3 {
    white-space: pre-line;
    font-size: 32px;
    line-height: 1.15;
    margin-bottom: 18px;
  }
  .service-panel p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }
  .service-panel ul {
    padding: 0;
    margin: 24px 0;
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 24px;
  }
  .service-panel li {
    border-top: 1px solid var(--line);
    padding-top: 10px;
    font-size: 12px;
    color: var(--muted);
  }
  .service-panel .service-offer {
    color: var(--blue);
    margin-bottom: 20px;
    font-size: 13px;
  }
  .service-deliverables {
    margin: 20px 0;
    border-block: 1px solid var(--line);
    padding-block: 14px;
  }
  .service-deliverables summary {
    cursor: pointer;
    color: var(--blue);
    font-size: 14px;
    min-height: 30px;
  }
  .service-deliverables h4 {
    font-size: 14px;
    margin-top: 20px;
  }
  .service-deliverables ul {
    display: block;
    margin: 12px 0;
    padding-left: 18px;
    list-style: disc;
  }
  .service-deliverables li {
    border: 0;
    padding: 0;
    margin-bottom: 8px;
  }
  .service-panel .text-link {
    color: var(--blue);
  }
  @media (max-width: 1000px) {
    .explorer-grid {
      gap: 32px;
    }
    .service-label strong {
      font-size: 21px;
    }
    .service-menu button {
      gap: 12px;
      padding-inline: 12px;
    }
  }
  @media (max-width: 700px) {
    .explorer-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .service-menu {
      flex-direction: row;
      overflow-x: auto;
      padding-bottom: 8px;
    }
    .service-menu button {
      flex: 0 0 210px;
      align-items: flex-start;
      padding: 18px 14px;
    }
    .service-menu :global(.arrow-icon) {
      display: none;
    }
    .service-label strong {
      font-size: 20px;
    }
    .service-photo img {
      height: 240px;
    }
    .service-panel-copy {
      padding: 24px 20px;
    }
    .service-panel h3 {
      font-size: 28px;
    }
    .services-heading {
      margin-bottom: 28px;
    }
  }
</style>
