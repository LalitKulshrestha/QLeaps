---
import Arrow from './Arrow.astro';
const {
  title = 'What is the next people decision\nyou need to get right?',
  description = 'Tell us what you’re building, what’s getting in the way and where you’d like support. We’ll start with a conversation.',
  href = '/contact/',
  label = 'Discuss your brief',
} = Astro.props;
---

<section class="wrap closing-cta" data-reveal>
  <div>
    <p class="eyebrow">Start with a conversation</p><h2>{title}</h2><p>
      {description}
    </p>
  </div><a class="button" href={href}>{label}<Arrow diagonal /></a><div
    class="closing-paths"
    aria-hidden="true"
  >
    <span></span><span></span><span></span>
  </div>
</section>
<style>
  .closing-cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    background: #eff6ff;
    border: 1px solid #dbeafe;
    padding: 48px;
    border-radius: 12px;
  }
  .closing-cta > div:first-child,
  .closing-cta > a {
    position: relative;
    z-index: 1;
  }
  .closing-cta .eyebrow {
    font-size: 10px;
    color: #1d4ed8;
  }
  .closing-cta h2 {
    white-space: pre-line;
    font-size: clamp(30px, 3.5vw, 46px);
    margin: 20px 0;
  }
  .closing-cta p:not(.eyebrow) {
    font-size: 15px;
    line-height: 1.7;
    color: var(--muted);
    max-width: 56ch;
  }
  .closing-cta .button {
    flex-shrink: 0;
  }
  .closing-paths {
    position: absolute;
    right: -90px;
    top: 50%;
    width: 420px;
    height: 420px;
    transform: translateY(-50%);
    pointer-events: none;
    z-index: 0;
  }
  .closing-paths span {
    position: absolute;
    inset: 0;
    border: 1px solid #2563eb30;
    border-radius: 50%;
    animation: closing-orbit 30s linear infinite;
  }
  .closing-paths span:nth-child(2) {
    inset: 40px;
    animation-direction: reverse;
  }
  .closing-paths span:nth-child(3) {
    inset: 80px;
  }
  .closing-paths span::before {
    content: '';
    position: absolute;
    top: -3px;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #2563eb66;
  }
  @keyframes closing-orbit {
    to {
      transform: rotate(360deg);
    }
  }
  @media (max-width: 860px) {
    .closing-cta {
      padding: 32px;
      align-items: flex-start;
      flex-direction: column;
      gap: 26px;
    }
  }
  @media (max-width: 540px) {
    .closing-cta {
      padding: 28px 24px;
    }
  }
</style>
